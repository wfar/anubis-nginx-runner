# Settings for Anubis and scripts.


# Required.
# Hostnames Anubis may send visitors back to after a challenge,
# comma-separated, e.g. example.com,www.example.com.
ANUBIS_REDIRECT_DOMAINS=

# Anubis release version to build, e.g. v1.28.2.
Empty builds the latest stable release.
ANUBIS_VERSION=

# Parent domain to share the pass cookie across subdomains, e.g. example.com.
# Empty scopes it to the exact hostname.
ANUBIS_COOKIE_DOMAIN=

# Key that signs the pass cookie, created on first run.
# Use a fixed path to avoid path conflicts.
ANUBIS_KEY_FILE="$HOME/.config/anubis/ed25519.key"

# Prometheus metrics endpoint. Keep it on loopback.
ANUBIS_METRICS_BIND=127.0.0.1:9923
